# Telegram Bot sozlamalari
# @BotFather orqali olingan bot tokeni
BOT_TOKEN=8861677441:AAGZuUBqRKgkmbm7kpnCTRjJgOzIAt3UVHM

# Administratorlar Telegram ID raqamlari (bir nechta bo'lsa vergul bilan ajrating: 12345678,87654321)
# O'z ID raqamingizni @userinfobot orqali bilib olishingiz mumkin
ADMIN_IDS=123456789

# AI Provayder sozlamalari
# Mavjud variantlar: 'openai' yoki 'gemini'
AI_PROVIDER=openai

# Agar AI_PROVIDER=openai tanlansa:
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
# OpenAI-mos boshqa provayderlar uchun (Groq, DeepSeek, OpenRouter va h.k. - bo'sh qoldirilsa rasmiy OpenAI ishlatiladi):
OPENAI_BASE_URL=

# Agar AI_PROVIDER=gemini tanlansa:
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-1.5-flash

# SQLite ma'lumotlar bazasi fayli nomi
DATABASE_PATH=genius_ai.db
